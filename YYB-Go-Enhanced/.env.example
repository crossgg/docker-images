# ============================================================================
# YYB-Go-Enhanced 运行环境变量配置文件
# 修改后重载容器生效：docker compose up -d
# ============================================================================

# ---------- Web 管理控制台与认证配置 ----------
# 认证驱动，默认使用 sqlite 保存于 resource/db/auth.db（也可设为 mysql）
YYB_AUTH_DRIVER=sqlite
YYB_AUTH_DSN=

# 初始化管理员账号密码（如未填写，第一个注册账号自动成为管理员）
YYB_ADMIN_USER=admin
YYB_ADMIN_PASSWORD=replace-with-a-strong-password

# 使用 HTTPS 反向代理时设为 true
YYB_COOKIE_SECURE=false

# ---------- Web 服务与端口设置 ----------
# Web 控制台对外监听端口
YYB_PORT=8000

# 监听绑定地址（0.0.0.0 允许所有网络访问，局域网限定可填如 192.168.1.10）
YYB_BIND_ADDRESS=0.0.0.0

# ---------- 账号凭据自动保活设置 ----------
# 后台检查轮询间隔（默认 1m，设为 0 可关闭后台保活）
YYB_KEEPALIVE_INTERVAL=1m

# 提前续期时间阈值（凭据到期前该时间内触发续期）
YYB_KEEPALIVE_AHEAD=45m

# ---------- 面板对接配置 (PANEL_TYPE & PANEL_NETWORK) ----------
# 可选值: qinglong (默认青龙面板) 或 daidai (呆呆面板)
PANEL_TYPE=daidai

# 共享外部 Docker 网络名称（Compose 会自动将容器连接至该外部网络）：
# - 青龙面板默认: qinglong_default
# - 呆呆面板默认: daidai-panel_default
PANEL_NETWORK=daidai_default

# ----- 青龙面板（Qinglong）配置 -----
# 青龙面板地址（容器同网络下可填写容器名，如 http://qinglong:5700）
QL_URL=http://qinglong:5700
# 青龙 OpenAPI Client ID（在青龙面板-系统设置-应用设置中创建）
QL_CLIENT_ID=
# 青龙 OpenAPI Client Secret
QL_CLIENT_SECRET=
# 填入青龙环境变量的 YYB_SERVER 服务地址（如 yyb:8000）
YYB_QINGLONG_SERVER=yyb-go:8000

# ----- 呆呆面板（Daidai）配置 -----
# 呆呆面板配置 (当 PANEL_TYPE=daidai 时可单独指定，不填则自动使用默认 http://daidai-panel:5700)
DAIDAI_URL=http://daidai-panel:5700
DAIDAI_APP_KEY=
DAIDAI_APP_SECRET=

# 同步的脚本仓库列表 (多个库用逗号分隔)
YYB_QINGLONG_REPO=SuperNaiBA_YYB-GO-Script,525815266_YYB-Go-Enhanced/scripts
