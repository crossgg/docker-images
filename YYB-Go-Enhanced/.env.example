# ============================================================================
# YYB-Go-Enhanced 运行环境变量配置文件
# 修改后重载容器生效：docker compose up -d
# ============================================================================

# ---------- Web 服务与端口设置 ----------
# Web 控制台对外监听端口
YYB_PORT=8000

# 监听绑定地址（0.0.0.0 允许所有网络访问，局域网限定可填如 192.168.1.10）
YYB_BIND_ADDRESS=0.0.0.0

# ---------- Web 控制台 Basic Auth 认证账号密码 ----------
YYB_WEB_USER=admin
YYB_WEB_PASSWORD=replace-with-a-strong-password

# ---------- 账号凭据自动保活设置 ----------
# 后台检查轮询间隔（设为 0 可关闭后台保活）
YYB_KEEPALIVE_INTERVAL=30m

# 提前续期时间阈值（凭据到期前该时间内触发续期）
YYB_KEEPALIVE_AHEAD=45m
## 选择面板类型：qinglong 或 daidai
PANEL_TYPE=qinglong
# ---------- 青龙面板（Qinglong）对接配置（可选）----------
# 青龙面板地址（容器同网络下可填写容器名，如 http://qinglong:5700）
QL_URL=http://qinglong:5700

# 青龙 OpenAPI Client ID（在青龙面板-系统设置-应用设置中创建）
QL_CLIENT_ID=

# 青龙 OpenAPI Client Secret
QL_CLIENT_SECRET=

# 填入青龙环境变量的 YYB_SERVER 服务地址（供青龙脚本回调使用，如 yyb:8000）
YYB_QINGLONG_SERVER=yyb:8000
