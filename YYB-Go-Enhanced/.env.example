# ============================================================================
# YYB-Go-Enhanced 运行环境变量配置文件
# 修改后重载容器生效：docker compose up -d
# ============================================================================

# ---------- Web 服务与端口设置 ----------
# Web 控制台对外监听端口
YYB_PORT=8000

# 监听绑定地址（0.0.0.0 允许所有网络访问，局域网可填如 192.168.1.10）
YYB_BIND_ADDRESS=0.0.0.0

# ---------- Web 控制台 Basic Auth 认证账号密码 ----------
YYB_WEB_USER=admin
YYB_WEB_PASSWORD=change_this_password_123

# ---------- 账号凭据自动保活设置 ----------
# 后台检查轮询间隔（设为 0 可关闭后台保活）
YYB_KEEPALIVE_INTERVAL=30m

# 提前续期时间阈值（凭据到期前该时间内触发续期）
YYB_KEEPALIVE_AHEAD=45m
