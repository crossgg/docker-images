# 容器名称
CONTAINER_NAME=my-go-app

# 目标 Go 二进制程序名称（放入挂载到 /app 的目录中）
APP_NAME=myapp

# 启动参数（如配置文件路径、端口参数等）
APP_ARGS=-c /app/config.yaml --port 8080

# 端口映射配置
HOST_PORT=8080
CONTAINER_PORT=8080

# 本地数据挂载目录（存放 Go 二进制和配置文件的本地路径）
DATA_DIR=./app

# 时区配置
TZ=Asia/Shanghai

# 可选：主程序启动前执行的前置脚本/命令
PRE_RUN_CMD=

# 自定义环境变量
