# ============================================================================
# NapCat 运行环境变量（docker compose 自动读取，无需手动 export）
# 本文件同时用于：
#   1) compose 的 ${} 占位符插值（端口等，需 Docker Compose v2.24.0+）
#   2) 注入到容器内部的环境变量（NAPCAT_* / WEBUI_TOKEN 等）
#
# 验证：docker compose config  可检查 .env 是否被正常读取、无报错
# ============================================================================

# ---------- 端口映射（改这里即可换端口）----------
# OneBot HTTPSocket 对外端口
OB_HTTP_PORT=6001
# OneBot WebSocket 对外端口
OB_WS_PORT=6002
# NapCat WebUI 对外端口
WEBUI_PORT=6099

# ---------- 权限（让挂载目录归宿主机当前用户，避免 root 属主文件）----------
NAPCAT_UID=1001
NAPCAT_GID=1001
# ----------MAC地址持久化固定----------------
MAC=02-9b-3f-a8-51-7c
# ---------- WebUI 登录 Token（不设则每次启动随机，需查日志）----------
WEBUI_TOKEN=napcat

# ---------- 快速登录：填 QQ 号可跳过扫码（需先手动登录过一次）----------
# ACCOUNT=123456789

# ============================================================================
# QQ 协议层代理（NapCat 原生 SOCKS5）
#
# 用「主机上的代理」时，地址坚决不能写 127.0.0.1（那指向容器自己！）
#   代理在宿主机上：
#     Linux 默认网桥            -> 172.17.0.1
#     Docker Desktop(Win/Mac)   -> host.docker.internal   （compose 已配 extra_hosts 自动解析）
#     宿主机的局域网 IP          -> 如 192.168.1.50
#   代理是另一个容器             -> 写容器名（需同网络）
#   代理在别的机器               -> 填对方 IP
#
# 限制：NapCat 原生代理只支持【无密码 SOCKS5】，不支持 HTTP、也不支持账号密码。
#      带密码的代理请看 docker-compose.sidecar-tun.yml（mihomo 旁路方案）。
# ============================================================================
# 主机代理地址（按上面说明改）
# ⚠️ 变量名必须是下面这两个，这是 NapCat 源码 handleProxy() 实际读取的名字。
#    写 PROXY_HOST / PROXY_PORT 它不认，代理会静默不生效。
NAPCAT_PROXY_ADDRESS=172.17.0.1
# 主机代理端口
NAPCAT_PROXY_PORT=7890

# 想临时关代理：取消下面一行注释（或把上面两行注释掉）
# NAPCAT_PROXY_CLOSE=1
